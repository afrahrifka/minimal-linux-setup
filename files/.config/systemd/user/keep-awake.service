[Unit]
Description=Keep laptop awake, including with lid closed

[Service]
Type=simple
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle:handle-lid-switch --who=MinimalDesktop --why=Keep-laptop-online --mode=block /usr/bin/sleep infinity
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
